ENV=dev
GCP_PROJECT_ID=hardy-portal-455916-d3
# Raw zips + bronze parquet. Empty = derived as {GCP_PROJECT_ID}-susep-ses-data.
GCS_DATA_BUCKET=
GCP_BQ_DATASET_BRONZE=susep_ses_bronze
GCP_BQ_DATASET_STAGING=susep_ses_staging
GCP_BQ_DATASET_MARTS=susep_ses_marts
SUSEP_SES_URL=https://www2.susep.gov.br/menuestatistica/SES/principal.aspx

# Insights agent (CP-C+). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Alternative: bill runs to a Claude Pro/Max subscription instead of API
# credits. Generate with `claude setup-token` (valid ~1 year). When set, it
# WINS over ANTHROPIC_API_KEY; usage shares the subscription's rate limits.
CLAUDE_CODE_OAUTH_TOKEN=
AGENT_MODEL=sonnet
AGENT_MAX_TURNS=20
AGENT_MAX_BUDGET_USD=0.75

# Report storage (GCS). Empty = derived as {GCP_PROJECT_ID}-susep-ses-reports.
GCP_REPORTS_BUCKET=
# Agent service account email (the one behind the GCP_AGENT_SA GitHub secret).
# Used only by bootstrap 04 to grant it access to the reports bucket.
GCP_AGENT_SA=

# Report e-mail delivery via Brevo (optional; all three required to enable
# sending). Create the key at Brevo > SMTP & API > API keys. REPORT_EMAIL_FROM
# must be a sender verified in Brevo (Senders & IPs). REPORT_EMAIL_TO accepts
# a comma-separated list.
BREVO_API_KEY=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=

# Agent provider: anthropic (default) or local (LM Studio >= 0.4.1 with the
# server running and a model loaded; set AGENT_MODEL to the LM Studio model id,
# e.g. google/gemma-3-27b, and give it 25k+ tokens of context).
AGENT_PROVIDER=anthropic
LMSTUDIO_BASE_URL=http://localhost:1234

# Interactive analyst chat (uv run python -m src.chat.cli).
# max turns per question; budget caps the WHOLE conversation (anthropic only).
CHAT_MAX_TURNS=30
CHAT_MAX_BUDGET_USD=2.0

# News search via Tavily (https://tavily.com, free tier ~1k/mo). Empty key =
# the search_news tool is not registered. Cap is per agent/chat run.
TAVILY_API_KEY=
NEWS_MAX_SEARCHES=5
# Optional CSV whitelist of outlets for search_news (empty = open web search
# boosted to Brazil), e.g.: sonhoseguro.com.br,cqcs.com.br,valor.globo.com
NEWS_INCLUDE_DOMAINS=
