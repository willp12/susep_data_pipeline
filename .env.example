ENV=dev
AWS_S3_BUCKET=susep-ses-data
AWS_REGION=us-east-1
GCP_PROJECT_ID=hardy-portal-455916-d3
GCP_BQ_DATASET_BRONZE=susep_ses_bronze
GCP_BQ_DATASET_STAGING=susep_ses_staging
GCP_BQ_DATASET_MARTS=susep_ses_marts
SUSEP_SES_URL=https://www2.susep.gov.br/menuestatistica/SES/principal.aspx

# Insights agent (CP-C+). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
AGENT_MODEL=sonnet
AGENT_MAX_TURNS=20
AGENT_MAX_BUDGET_USD=0.75

# Report storage (GCS). Empty = derived as {GCP_PROJECT_ID}-susep-ses-reports.
GCP_REPORTS_BUCKET=
# Agent service account email (the one behind the GCP_AGENT_SA GitHub secret).
# Used only by bootstrap 04 to grant it access to the reports bucket.
GCP_AGENT_SA=

# Report e-mail delivery (optional; all three required to enable sending).
# Gmail: create an app password at https://myaccount.google.com/apppasswords
# (needs 2FA). SMTP_HOST/PORT default to smtp.gmail.com:465 (SSL).
SMTP_USERNAME=
SMTP_APP_PASSWORD=
REPORT_EMAIL_TO=
# Optional; defaults to SMTP_USERNAME.
REPORT_EMAIL_FROM=

# Agent provider: anthropic (default) or local (LM Studio >= 0.4.1 with the
# server running and a model loaded; set AGENT_MODEL to the LM Studio model id,
# e.g. google/gemma-3-27b, and give it 25k+ tokens of context).
AGENT_PROVIDER=anthropic
LMSTUDIO_BASE_URL=http://localhost:1234

# Interactive analyst chat (uv run python -m src.chat.cli).
# max turns per question; budget caps the WHOLE conversation (anthropic only).
CHAT_MAX_TURNS=30
CHAT_MAX_BUDGET_USD=2.0
